# Maven
target/
*.jar
*.war
*.ear

# IDE
.idea/
*.iml
.vscode/
.settings/
.project
.classpath

# 操作系统
.DS_Store
Thumbs.db

# 日志
*.log
logs/

# 前端
node_modules/
dist/

# Local runtime/state and TypeScript incremental build cache
*.rdb
*.tsbuildinfo
backend/data/
/backend/.test-tmp/
/data/
.vite/

# Office temporary lock files
~$*.docx

# Academic originals live in the sibling Coffer资料 directory, outside this public repository.
# Prevent accidentally adding a new academic report to the flattened docs directory.
/docs/*.docx
/docs/**/*.docx

# Locally generated launcher secrets; never commit these.
*-local.cmd
coffer-initial-admin-token.txt
.coffer-encryption-key
.coffer-runtime/
*.cofferbackup
*.coffer-upgrade.json

# Local E2E input documents are not part of the repository.
/backend/e2e-sample/
/.test-tmp/
/frontend/.test-tmp/
/desktop/.build/
/desktop/.test-tmp/

# GPU driver diagnostic directories may appear when desktop tools run here.
/NVIDIA Corporation/

# Production target credentials, TLS material, backup archives and evidence.
/deploy/.env
/deploy/secrets/
/deploy/tls/
/deploy/evidence/
/deploy/backups/
/deploy/__pycache__/
/deploy/internal-tls/
/deploy/.maintenance.json
/deploy/.active-compose.json
