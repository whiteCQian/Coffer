COMPOSE_PROJECT_NAME=coffer
COFFER_DOMAIN=files.example.com
# Restrict to a trusted LAN/VPN address if this is a private NAS deployment.
HTTPS_BIND_IP=0.0.0.0
COFFER_RELEASE=2026.10.10
# Must not overlap the host/VPN routing table. Proxy alone is trusted for XFF.
PROXY_SUBNET=172.30.44.0/24
PROXY_DYNAMIC_RANGE=172.30.44.128/25
PROXY_IP=172.30.44.2
# Physical objects (including retained/orphan copies) count until verified deletion.
ACCOUNT_STORAGE_BYTES=10737418240
TOTAL_STORAGE_BYTES=107374182400
ACCOUNT_STORAGE_OBJECTS=10000
ACCOUNT_PENDING_TASKS=20
ACCOUNT_CONCURRENT_TASKS=2
