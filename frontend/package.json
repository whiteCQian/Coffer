{
  "name": "coffer-frontend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Coffer 智能文件管家 · 前端（Vue3 + Element Plus）",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "api:generate": "openapi-typescript http://127.0.0.1:8080/v3/api-docs -o src/api/generated/schema.ts",
    "api:check": "npm run api:generate && git diff --exit-code -- src/api/generated/schema.ts"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.7.9",
    "element-plus": "^2.9.1",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.7.3",
    "vite": "^6.1.0",
    "vue-tsc": "^2.2.0"
  }
}
